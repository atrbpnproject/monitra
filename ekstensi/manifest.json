{
  "manifest_version": 3,
  "name": "Rekap Tunggakan Kanwil (Kinerja Kantor Pertanahan)",
  "version": "1.2.0",
  "description": "Merekap berkas proses melebihi SPOPP untuk seluruh kantah dalam satu Kanwil dari dashboard Kinerja Kantor Pertanahan, lalu mengunduhnya sebagai Excel atau mengirimnya ke web Monitra.",
  "content_scripts": [
    {
      "matches": [
        "https://aplikasi.atrbpn.go.id/dashboard/statistik/KinerjaKantorPertanahan*"
      ],
      "js": [
        "xlsxwriter.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://atrbpnproject.github.io/monitra/*"
      ],
      "js": [
        "monitra-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Rekap Tunggakan Kanwil",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://aplikasi.atrbpn.go.id/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
